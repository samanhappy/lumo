POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_HOST=127.0.0.1
APP_PORT=5173
# 本地构建保持 lumo-local。服务器一键部署默认加载 docker.io/samanhappy/lumo:latest，请在服务器 .env 中设置相同 APP_IMAGE。
APP_IMAGE=lumo-local

# 必须修改密码；家长的 studentId 关联学生，修改用户名不影响学习数据。
LUMO_USERS='[{"username":"student","password":"change-student-password","role":"student","studentId":"local-student","name":"小雨"},{"username":"parent","password":"change-parent-password","role":"parent","studentId":"local-student","name":"小雨家长"}]'
# 使用 HTTPS 时设为 true
COOKIE_SECURE=false

# pi 学习助手：deepseek 或 openai；模型 ID 必须存在于安装版本的 pi 目录中。
LUMO_AI_PROVIDER=deepseek
LUMO_AI_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 作业图片使用独立视觉模型，必须支持 image 输入；密钥复用上方 OPENAI_API_KEY。
LUMO_VISION_PROVIDER=openai
LUMO_VISION_MODEL=
